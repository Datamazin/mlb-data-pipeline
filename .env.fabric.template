# Microsoft Fabric Connection Configuration
# Copy this file to .env and fill in your Fabric details

# Fabric SQL Endpoint (Required)
# Example: xyz-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SERVER=niagdix6nenejo5yletqutjpae-apygryrrgdhupeevwhp3xhozjy.datawarehouse.fabric.microsoft.com

# Database/Warehouse Name (Optional - defaults to mlb_data)
FABRIC_DATABASE=mlb_data

# Azure AD Authentication (Optional - leave blank for integrated auth)
# If you want to use username/password authentication instead of integrated:
FABRIC_USERNAME=
FABRIC_PASSWORD=

# Note: If FABRIC_USERNAME and FABRIC_PASSWORD are not provided,
# the connection will use Azure AD Integrated authentication with your current credentials
